# Optional ReliefRN website server configuration; see SETUP.md and RUN-LOCALLY.md. No credentials included.
#
# Live agents: the ReliefRN website talks to the local agent bridge, which holds the Azure
# sign-in. Azure credentials belong in agent-bridge/.env, not here.
AGENT_BRIDGE_URL=
AGENT_BRIDGE_TOKEN=

# Human callbacks (optional): a support service you control.
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_TOKEN=
SUPPORT_VOICE_NUMBER=
SUPPORT_SMS_NUMBER=
