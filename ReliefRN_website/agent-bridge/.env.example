# Copy to .env (same folder). .env is git-ignored — never commit it.
#
# TEAM MEMBERS: leave everything blank. The bridge uses `az login`, or opens a
# browser sign-in window, with your own Azure account.
#
# JUDGES: paste the three values the ReliefRN team sent you privately.
AZURE_TENANT_ID=9e857255-df57-4c47-a0c0-0546460380cb
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

